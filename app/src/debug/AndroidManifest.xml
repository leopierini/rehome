<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the Watch Next test rows (WatchNextTestRows, TestHooks "rehome_test_watchnext test"). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the launcher write and delete its OWN test rows in the TV provider (protection level normal); it cannot
         touch other apps' rows. Not in the release build. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <application>
        <!-- A poster that never ends (TestStallProvider). Not exported: only the launcher reads it. -->
        <provider
            android:name=".TestStallProvider"
            android:authorities="${applicationId}.teststall"
            android:exported="false" />
    </application>
</manifest>
