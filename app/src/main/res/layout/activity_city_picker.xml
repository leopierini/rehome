<?xml version="1.0" encoding="utf-8"?>
<!-- The weather city (CityPickerActivity): a search field for the TV's keyboard, the places found, and a row that
     turns the weather off. Same page and rows as Launcher settings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:orientation="vertical"
    android:paddingStart="72dp"
    android:paddingEnd="72dp"
    android:paddingTop="38dp"
    android:paddingBottom="38dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/weather_city_label"
        android:textColor="#FFFFFFFF"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/cityNow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textColor="#FFACB8C1"
        android:textSize="16sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/cityQuery"
        style="@style/SettingsRow"
        android:layout_marginTop="28dp"
        android:hint="@string/city_search_hint"
        android:importantForAutofill="no"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:inputType="textCapWords|textNoSuggestions"
        android:maxLines="1"
        android:textColorHint="#FFACB8C1" />

    <TextView
        android:id="@+id/cityStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="#FFACB8C1"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- The places found; the rows are added by CityPickerActivity. The list clips itself (ClipScrollView), so the
         places it scrolls past never draw over "Turn weather off" or the screen's edge; it reaches 8dp (a focused
         row's glow, settings_choice_bg) into the page's side padding, and its rows are padded back by as much. -->
    <io.github.leopierini.rehome.ClipScrollView
        android:id="@+id/cityScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="-8dp"
        android:layout_marginEnd="-8dp"
        android:layout_marginTop="4dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/cityResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </io.github.leopierini.rehome.ClipScrollView>

    <TextView
        android:id="@+id/cityOff"
        style="@style/SettingsRow"
        android:layout_marginTop="12dp"
        android:text="@string/weather_turn_off" />
</LinearLayout>
