<?xml version="1.0" encoding="utf-8"?>
<!-- wifi_status_warnings: the Wi-Fi pill's icon while connected but not validated (a captive portal waiting for its
     login page), orange, on the focused pill too. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dropdown open (pill_bg): the status colour on the open glass. -->
    <item android:state_activated="true" android:state_window_focused="false" android:color="#FFFF9F0A" />
    <item android:state_focused="true" android:color="#FFFF9F0A" />
    <item android:color="#FFFF9F0A" />
</selector>
