<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary lines of a list row (package, signing key, an input's "Connected"): a dim white on the dark glass,
     brighter on the focused row's glass (input_row_bg). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#B3FFFFFF" />
    <item android:color="#73FFFFFF" />
</selector>
